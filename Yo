<title>GameMarket Hooks — Échanges & Prix des 5 Jeux les Plus Médiatisés</title>
<style>
    * { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; }
    :root {
        --bg: #0a0a0f; --bg2: #111118; --bg3: #1a1a24;
        --panel: #16161f; --panel2: #1e1e2a; --border: #2a2a3a;
        --ink: #e8e8f0; --dim: #8888a0; --faint: #55556a;
        --success: #2ecc71; --error: #e74c3c; --warn: #f39c12;
        --accent: #6366f1; --accent2: #8b5cf6;
        --fc: #00b4d8; --cs: #ff6b35; --fn: #9b59b6; --rl: #3498db; --vl: #ff4655;
        --radius: 12px;
    }
    body {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        background: var(--bg); color: var(--ink); min-height: 100vh;
        padding: 1.2rem 1rem 6rem; font-size: 15px; line-height: 1.5;
        max-width: 1100px; margin: 0 auto;
    }

    /* ── HEADER ── */
    header { margin-bottom: 1.8rem; text-align: center; }
    .logo { font-size: 1.8rem; font-weight: 800; letter-spacing: -0.04em;
        background: linear-gradient(135deg, var(--accent), var(--accent2), var(--fc));
        -webkit-background-clip: text; -webkit-text-fill-color: transparent; margin-bottom: 0.2rem; }
    .subtitle { font-size: 0.8rem; color: var(--dim); font-style: italic; }

    /* ── TICKER ── */
    .ticker-wrap { background: var(--bg2); border: 1px solid var(--border); border-radius: 8px; overflow: hidden; margin-bottom: 1.5rem; padding: 0.5rem 0; }
    .ticker { display: flex; gap: 2rem; animation: ticker 40s linear infinite; white-space: nowrap; width: max-content; }
    .ticker:hover { animation-play-state: paused; }
    @keyframes ticker { 0% { transform: translateX(0); } 100% { transform: translateX(-50%); } }
    .ticker-item { font-size: 0.72rem; font-family: ui-monospace, monospace; display: flex; align-items: center; gap: 0.4rem; }
    .ticker-item .tk-name { color: var(--dim); }
    .ticker-item .tk-price { color: var(--ink); font-weight: 600; }
    .ticker-item .tk-up { color: var(--success); }
    .ticker-item .tk-down { color: var(--error); }

    /* ── TABS JEUX ── */
    .game-tabs { display: flex; gap: 0.4rem; overflow-x: auto; padding-bottom: 0.5rem; margin-bottom: 1.2rem; scrollbar-width: none; }
    .game-tabs::-webkit-scrollbar { display: none; }
    .game-tab {
        flex-shrink: 0; padding: 0.6rem 1rem; border-radius: 20px;
        border: 1px solid var(--border); background: var(--panel);
        color: var(--dim); font-size: 0.78rem; font-weight: 600; cursor: pointer;
        transition: all 0.15s; display: flex; align-items: center; gap: 0.4rem;
    }
    .game-tab:active { transform: scale(0.96); }
    .game-tab.active { color: #fff; border-color: transparent; }
    .game-tab[data-game="fc"].active { background: var(--fc); }
    .game-tab[data-game="cs"].active { background: var(--cs); }
    .game-tab[data-game="fn"].active { background: var(--fn); }
    .game-tab[data-game="rl"].active { background: var(--rl); }
    .game-tab[data-game="vl"].active { background: var(--vl); }
    .game-tab .gt-emoji { font-size: 1rem; }

    /* ── PANELS ── */
    .game-panel { display: none; animation: fadeIn 0.3s ease; }
    .game-panel.active { display: block; }
    @keyframes fadeIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }

    .game-hero {
        border-radius: var(--radius); padding: 1.2rem 1.3rem; margin-bottom: 1rem;
        position: relative; overflow: hidden;
    }
    .game-hero::before {
        content: ''; position: absolute; inset: 0; opacity: 0.08;
        background: radial-gradient(circle at 30% 20%, #fff, transparent 60%);
    }
    .game-hero[data-game="fc"] { background: linear-gradient(135deg, #003049, #00b4d8); }
    .game-hero[data-game="cs"] { background: linear-gradient(135deg, #2b1a0e, #ff6b35); }
    .game-hero[data-game="fn"] { background: linear-gradient(135deg, #1a0b2e, #9b59b6); }
    .game-hero[data-game="rl"] { background: linear-gradient(135deg, #0a1a2e, #3498db); }
    .game-hero[data-game="vl"] { background: linear-gradient(135deg, #1a0a0e, #ff4655); }
    .game-hero h2 { font-size: 1.3rem; font-weight: 700; color: #fff; margin-bottom: 0.2rem; position: relative; }
    .game-hero p { font-size: 0.78rem; color: rgba(255,255,255,0.75); position: relative; }

    /* ── STATS GRID ── */
    .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 0.6rem; margin-bottom: 1rem; }
    .stat-card {
        background: var(--panel); border: 1px solid var(--border); border-radius: 10px;
        padding: 0.8rem 1rem; display: flex; flex-direction: column; gap: 0.3rem;
    }
    .stat-card .sc-label { font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--dim); font-weight: 600; }
    .stat-card .sc-value { font-size: 1.1rem; font-weight: 700; font-family: ui-monospace, monospace; }
    .stat-card .sc-change { font-size: 0.7rem; font-weight: 600; }
    .stat-card .sc-change.up { color: var(--success); }
    .stat-card .sc-change.down { color: var(--error); }
    .stat-card .sc-change.neutral { color: var(--warn); }

    /* ── MARKET TABLE ── */
    .market-section { margin-bottom: 1.2rem; }
    .market-section h3 { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--dim); margin-bottom: 0.6rem; font-weight: 700; display: flex; align-items: center; gap: 0.5rem; }
    .market-section h3 .badge { background: var(--bg3); padding: 0.1rem 0.5rem; border-radius: 10px; font-size: 0.6rem; color: var(--faint); }

    .market-list { display: flex; flex-direction: column; gap: 0.4rem; }
    .market-item {
        display: flex; align-items: center; gap: 0.8rem;
        background: var(--panel); border: 1px solid var(--border);
        border-radius: 8px; padding: 0.65rem 0.9rem; transition: border-color 0.15s;
    }
    .market-item:hover { border-color: var(--faint); }
    .market-item .mi-icon { font-size: 1.2rem; flex-shrink: 0; width: 2rem; text-align: center; }
    .market-item .mi-info { flex: 1; min-width: 0; }
    .market-item .mi-name { font-size: 0.82rem; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .market-item .mi-meta { font-size: 0.65rem; color: var(--faint); margin-top: 0.1rem; }
    .market-item .mi-price { font-family: ui-monospace, monospace; font-size: 0.85rem; font-weight: 700; text-align: right; flex-shrink: 0; }
    .market-item .mi-trend { font-size: 0.65rem; font-weight: 600; text-align: right; flex-shrink: 0; width: 60px; }
    .mi-trend.up { color: var(--success); }
    .mi-trend.down { color: var(--error); }
    .mi-trend.flat { color: var(--faint); }

    /* ── HOOKS ── */
    .hooks-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 0.8rem; margin-top: 1rem; }
    .hook-card {
        background: var(--panel2); border: 1px solid var(--border); border-radius: 10px;
        padding: 1rem 1.1rem; position: relative; overflow: hidden;
    }
    .hook-card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px; }
    .hook-card[data-game="fc"]::before { background: var(--fc); }
    .hook-card[data-game="cs"]::before { background: var(--cs); }
    .hook-card[data-game="fn"]::before { background: var(--fn); }
    .hook-card[data-game="rl"]::before { background: var(--rl); }
    .hook-card[data-game="vl"]::before { background: var(--vl); }
    .hook-card .hc-tag { font-size: 0.6rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--dim); font-weight: 700; margin-bottom: 0.4rem; }
    .hook-card .hc-title { font-size: 0.9rem; font-weight: 700; margin-bottom: 0.4rem; line-height: 1.3; }
    .hook-card .hc-desc { font-size: 0.75rem; color: var(--dim); line-height: 1.5; }
    .hook-card .hc-action { display: inline-block; margin-top: 0.6rem; font-size: 0.7rem; font-weight: 700; color: var(--accent); text-decoration: none; }

    /* ── FOOTER ── */
    .footer { text-align: center; padding: 2rem 0 1rem; font-size: 0.65rem; color: var(--faint); border-top: 1px solid var(--border); margin-top: 2rem; }
    .footer a { color: var(--dim); text-decoration: none; }

    /* ── STATUS BAR ── */
    .status-bar {
        position: fixed; bottom: 0; left: 0; right: 0;
        background: var(--panel); border-top: 1px solid var(--border);
        padding: 0.6rem 1rem; font-size: 0.7rem; color: var(--dim);
        display: flex; justify-content: space-between; align-items: center;
        z-index: 100; font-family: ui-monospace, monospace;
    }
    .status-bar .live-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--success); display: inline-block; margin-right: 0.3rem; animation: pulse 1.5s infinite; }
    @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.4; } }

    .hidden { display: none !important; }
</style>
