// ══════════════════════════════════════════════════════════════════
// RENDU
// ══════════════════════════════════════════════════════════════════

function renderTicker() {
    const ticker = document.getElementById('ticker');
    const allItems = [];
    Object.entries(MARKET_DATA).forEach(([game, data]) => {
        data.ticker.forEach(t => {
            const arrow = t.trend === 'up' ? '▲' : t.trend === 'down' ? '▼' : '●';
            const cls = t.trend === 'up' ? 'tk-up' : t.trend === 'down' ? 'tk-down' : '';
            allItems.push(
                '<span class="ticker-item">' +
                    '<span class="tk-name">' + t.name + '</span>' +
                    '<span class="tk-price">' + t.price + '</span>' +
                    '<span class="' + cls + '">' + arrow + '</span>' +
                '</span>'
            );
        });
    });
    // Dupliquer pour boucle infinie
    ticker.innerHTML = allItems.join('') + allItems.join('');
}

function renderMarket(game) {
    const data = MARKET_DATA[game];
    if (!data) return;
    const container = document.getElementById(game + '-market');
    if (!container) return;
    container.innerHTML = data.market.map(m =>
        '<div class="market-item">' +
            '<span class="mi-icon">' + m.icon + '</span>' +
            '<div class="mi-info">' +
                '<div class="mi-name">' + m.name + '</div>' +
                '<div class="mi-meta">' + m.meta + '</div>' +
            '</div>' +
            '<div class="mi-price">' + m.price + '</div>' +
            '<div class="mi-trend ' + m.dir + '">' + m.trend + '</div>' +
        '</div>'
    ).join('');
}

function renderHooks(game) {
    const data = MARKET_DATA[game];
    if (!data) return;
    const container = document.getElementById(game + '-hooks');
    if (!container) return;
    container.innerHTML = data.hooks.map(h =>
        '<div class="hook-card" data-game="' + game + '">' +
            '<div class="hc-tag">' + h.tag + '</div>' +
            '<div class="hc-title">' + h.title + '</div>' +
            '<div class="hc-desc">' + h.desc + '</div>' +
        '</div>'
    ).join('');
}

// ══════════════════════════════════════════════════════════════════
// NAVIGATION
// ══════════════════════════════════════════════════════════════════

function switchGame(game) {
    document.querySelectorAll('.game-tab').forEach(t => t.classList.remove('active'));
    document.querySelectorAll('.game-panel').forEach(p => p.classList.remove('active'));
    document.querySelector('.game-tab[data-game="' + game + '"]').classList.add('active');
    document.getElementById('panel-' + game).classList.add('active');
    renderMarket(game);
    renderHooks(game);
}

// ══════════════════════════════════════════════════════════════════
// INIT
// ══════════════════════════════════════════════════════════════════

(function init() {
    // Ticker
    renderTicker();

    // Tabs
    document.querySelectorAll('.game-tab').forEach(tab => {
        tab.addEventListener('click', () => switchGame(tab.dataset.game));
    });

    // Panneau initial
    switchGame('fc');

    // Heure
    function updateTime() {
        const now = new Date();
        document.getElementById('status-time').textContent =
            now.toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' });
    }
    updateTime();
    setInterval(updateTime, 30000);

    // Auto-refresh des données toutes les 60 secondes (à brancher sur de vraies API)
    setInterval(() => {
        renderTicker();
        const active = document.querySelector('.game-tab.active');
        if (active) {
            renderMarket(active.dataset.game);
            renderHooks(active.dataset.game);
        }
    }, 60000);
})();
</script>

